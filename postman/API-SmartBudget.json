    {
      "name": "categories",
      "item": [
        {
          "name": "Создать новую пользовательскую категорию",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"categoryId\", null);"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Category created successfully\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json()).to.have.property(\"id\");",
                  "    pm.expect(pm.response.json().name).to.equal(\"Новая категория\");",
                  "    var categoryId = pm.response.json().id;",
                  "    pm.environment.set(\"categoryId\", categoryId);",
                  "    pm.environment.set(\"test_category_id\", categoryId);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Новая категория\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{budgetBaseUrl}}/categories",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["categories"]
            }
          },
          "response": []
        },
        {
          "name": "Получить список всех доступных категорий",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Categories retrieved successfully\", function () {",
                  "    const json = pm.response.json();",
                  "",
                  "    pm.response.to.have.status(200);",
                  "",
                  "    pm.expect(json).to.be.an('object');",
                  "    pm.expect(json).to.have.property('content');",
                  "    pm.expect(json.content).to.be.an('array');",
                  "    pm.expect(json.content.length).to.be.greaterThan(0);",
                  "",
                  "    pm.expect(json.content[0]).to.have.property('id');",
                  "    pm.expect(json.content[0]).to.have.property('name');",
                  "",
                  "    const createdCategoryId = parseInt(pm.environment.get(\"categoryId\"));",
                  "    const found = json.content.some(category => category.id === createdCategoryId);",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{budgetBaseUrl}}/categories",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["categories"]
            }
          },
          "response": []
        },
        {
          "name": "Обновить существующую категорию",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var categoryId = pm.environment.get(\"categoryId\");",
                  "if (!categoryId) {",
                  "    throw new Error(\"Category ID is not set. Run 'Создать новую пользовательскую категорию' first.\");",
                  "}",
                  "pm.environment.set(\"currentCategoryId\", categoryId);"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Category updated successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.have.property(\"id\");",
                  "    pm.expect(pm.response.json().name).to.equal(\"Обновленная категория\");",
                  "    pm.expect(pm.response.json().id).to.equal(parseInt(pm.environment.get(\"currentCategoryId\")));",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Обновленная категория\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{budgetBaseUrl}}/categories/{{currentCategoryId}}",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["categories", "{{currentCategoryId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Удалить пользовательскую категорию",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var categoryId = pm.environment.get(\"currentCategoryId\");",
                  "if (!categoryId) {",
                  "    throw new Error(\"Category ID is not set. Run 'Обновить существующую категорию' first.\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Category deleted successfully\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{budgetBaseUrl}}/categories/{{currentCategoryId}}",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["categories", "{{currentCategoryId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "transactions (Транзакции)",
      "item": [
        {
          "name": "1. Запустить асинхронный импорт транзакций",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Import accepted (HTTP 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{transactionBaseUrl}}/transactions/sync?year=2025&month=10",
              "host": ["{{transactionBaseUrl}}"],
              "path": ["transactions", "sync"],
              "query": [
                { "key": "year", "value": "2025" },
                { "key": "month", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "2. Получить список транзакций с фильтрацией (Проверка категории)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Transactions retrieved successfully with pagination and filter\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(json).to.be.an('object');",
                  "    pm.expect(json).to.have.property('content').that.is.an('array');",
                  "    ",
                  "    if (json.content.length > 0) {",
                  "        pm.expect(json.content[0]).to.have.property('category');",
                  "        pm.expect(json.content[0].category).to.have.property('id');",
                  "        pm.expect(json.content[0].category).to.have.property('name');",
                  "        ",
                  "        pm.environment.set(\"firstTransactionId\", json.content[0].id);",
                  "    }",
                  "    pm.expect(json.pageable).to.have.property('pageNumber').to.equal(0);",
                  "    pm.expect(json.pageable).to.have.property('pageSize').to.equal(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{transactionBaseUrl}}/transactions?page=0&size=1&categoryId=1",
              "host": ["{{transactionBaseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "1" },
                { "key": "categoryId", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "3. Изменить категорию для конкретной транзакции",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var transactionId = 1;",
                  "var newCategoryId = 3;",
                  "",
                  "if (!transactionId || !newCategoryId) {",
                  "    throw new Error(\"Не установлены 'firstTransactionId' или 'test_category_id'. Сначала запустите предыдущие тесты.\");",
                  "}",
                  "",
                  "pm.environment.set(\"transactionToUpdateId\", transactionId);",
                  "pm.environment.set(\"newCategoryId\", newCategoryId);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Category updated successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    const expectedCategoryId = parseInt(pm.environment.get(\"newCategoryId\"));",
                  "    ",
                  "    pm.expect(json.category.id).to.equal(expectedCategoryId);",
                  "    pm.expect(json.id).to.equal(parseInt(pm.environment.get(\"transactionToUpdateId\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": {{newCategoryId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{transactionBaseUrl}}/transactions/{{transactionToUpdateId}}/category",
              "host": ["{{transactionBaseUrl}}"],
              "path": ["transactions", "{{transactionToUpdateId}}", "category"]
            }
          }
        }
      ]
    },
    {
      "name": "goals",
      "item": [
        {
          "name": "Создать новую цель",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 16 Pro Max\",\n  \"targetAmount\": 150000.00,\n  \"deadline\": \"2026-06-30\"\n}"
            },
            "url": {
              "raw": "{{goalBaseUrl}}/goals",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Goal created\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    console.log('--- Создать новую цель: ОТВЕТ ---', json);",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.name).to.eql('iPhone 16 Pro Max');",
                  "    pm.expect(json.targetAmount).to.eql(150000.00);",
                  "    pm.environment.set(\"goalId\", json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Внести деньги в цель",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25000.00\n}"
            },
            "url": {
              "raw": "{{goalBaseUrl}}/goals/{{goalId}}/contribute",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals", "{{goalId}}", "contribute"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Contribution added\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    console.log('--- Внести деньги в цель: ОТВЕТ ---', json);",
                  "    pm.expect(json.savedAmount).to.eql(25000.00);",
                  "    pm.expect(json.progressPercent).to.eql(16);",
                  "   ",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Получить все цели пользователя",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{goalBaseUrl}}/goals",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Goals list returned\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    console.log('--- Получить все цели: ОТВЕТ ---', json);",
                  "    pm.expect(json).to.be.an('array');",
                  "    pm.expect(json.length).to.be.at.least(1);",
                  "    const goal = json.find(g => g.id === parseInt(pm.environment.get('goalId')));",
                  "    ",
                  "    pm.expect(goal).to.be.an('object', 'Цель с goalId должна быть найдена в списке');",
                  "    ",
                  "    pm.expect(goal.savedAmount).to.eql(25000.00);",
                  "    pm.expect(goal.progressPercent).to.eql(16);",
                  "    pm.expect(goal.daysLeft).to.be.a('number');",
                  "    pm.expect(goal.recommendedMonthly).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Получить одну цель по ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{goalBaseUrl}}/goals/{{goalId}}",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals", "{{goalId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Single goal returned\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(parseInt(pm.environment.get('goalId')));",
                  "    pm.expect(json.name).to.eql('iPhone 16 Pro Max');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Удалить цель",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{goalBaseUrl}}/goals/{{goalId}}",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals", "{{goalId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Goal deleted\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
