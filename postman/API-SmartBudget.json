  "item": [
    {
      "name": "1. Categories (Категории)",
      "item": [
        {
          "name": "Create Category (POST)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNum = Math.floor(Math.random() * 100000);",
                  "pm.environment.set(\"unique_cat_name\", \"Test Cat \" + randomNum);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"created_cat_id\", jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{unique_cat_name}}\"\n}"
            },
            "url": {
              "raw": "{{budgetBaseUrl}}/categories",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Get All Categories (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.content).to.be.an('array');",
                  "pm.expect(jsonData.content.length).to.be.above(0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{budgetBaseUrl}}/categories?page=0&size=50",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["categories"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Update Category (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.name).to.contain(\"Updated\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{unique_cat_name}} Updated\"\n}"
            },
            "url": {
              "raw": "{{budgetBaseUrl}}/categories/{{created_cat_id}}",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["categories", "{{created_cat_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Budgets (Бюджеты)",
      "item": [
        {
          "name": "Create Budget (POST)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Получаем ТЕКУЩУЮ дату, чтобы Цели могли работать",
                  "var d = new Date();",
                  "pm.environment.set(\"budget_year\", d.getFullYear());",
                  "pm.environment.set(\"budget_month\", d.getMonth() + 1);",
                  "",
                  "// Используем ID созданной категории или 1 как fallback",
                  "var catId = pm.environment.get(\"created_cat_id\") || 1;"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.totalIncome).to.eql(300000);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": {{budget_year}},\n  \"month\": {{budget_month}},\n  \"totalIncome\": 300000,\n  \"limits\": [\n    {\n      \"categoryId\": {{created_cat_id}},\n      \"limitValue\": 100,\n      \"limitType\": \"PERCENT\"\n    },\n    {\n      \"categoryId\": {{created_cat_id}},\n      \"limitValue\": 50000,\n      \"limitType\": \"SUM\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{budgetBaseUrl}}/budgets",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["budgets"]
            }
          }
        },
        {
          "name": "Get Budget (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.year).to.eql(pm.environment.get(\"budget_year\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{budgetBaseUrl}}/budgets/{{budget_year}}/{{budget_month}}",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["budgets", "{{budget_year}}", "{{budget_month}}"]
            }
          }
        },
        {
          "name": "Get Budget Dashboard (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData).to.have.property(\"remainingBudget\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{budgetBaseUrl}}/budgets/{{budget_year}}/{{budget_month}}/dashboard",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["budgets", "{{budget_year}}", "{{budget_month}}", "dashboard"]
            }
          }
        },
        {
          "name": "Delete Budget (DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 204 No Content\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{budgetBaseUrl}}/budgets/{{budget_year}}/{{budget_month}}",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["budgets", "{{budget_year}}", "{{budget_month}}"]
            }
          }
        },
        {
          "name": "Restore Budget (Setup for Goals)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": {{budget_year}},\n  \"month\": {{budget_month}},\n  \"totalIncome\": 300000,\n  \"limits\": [\n    {\n      \"categoryId\": {{created_cat_id}},\n      \"limitValue\": 100,\n      \"limitType\": \"PERCENT\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{budgetBaseUrl}}/budgets",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["budgets"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Goals (Финансовые цели)",
      "item": [
        {
          "name": "Create Goal (POST)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var date = new Date();",
                  "date.setFullYear(date.getFullYear() + 1);",
                  "pm.environment.set(\"goal_deadline\", date.toISOString().split('T')[0]);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.environment.set(\"goal_id\", json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Car\",\n  \"targetAmount\": 2000000,\n  \"deadline\": \"{{goal_deadline}}\"\n}"
            },
            "url": {
              "raw": "{{goalBaseUrl}}/goals",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals"]
            }
          }
        },
        {
          "name": "Get Goal by ID (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.expect(json.id).to.eql(pm.environment.get(\"goal_id\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{goalBaseUrl}}/goals/{{goal_id}}",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals", "{{goal_id}}"]
            }
          }
        },
        {
          "name": "Update Goal (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.expect(json.name).to.contain(\"Updated\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Car Updated\",\n  \"targetAmount\": 2000000,\n  \"deadline\": \"{{goal_deadline}}\"\n}"
            },
            "url": {
              "raw": "{{goalBaseUrl}}/goals/{{goal_id}}",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals", "{{goal_id}}"]
            }
          }
        },
        {
          "name": "Contribute to Goal (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.expect(json.savedAmount).to.eql(10000);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000\n}"
            },
            "url": {
              "raw": "{{goalBaseUrl}}/goals/{{goal_id}}/contribute",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals", "{{goal_id}}", "contribute"]
            }
          }
        },
        {
          "name": "Get Active Goals (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.expect(json).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{goalBaseUrl}}/goals/active?year={{budget_year}}&month={{budget_month}}",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals", "active"],
              "query": [
                { "key": "year", "value": "{{budget_year}}" },
                { "key": "month", "value": "{{budget_month}}" }
              ]
            }
          }
        },
        {
          "name": "Delete Goal (DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{goalBaseUrl}}/goals/{{goal_id}}",
              "host": ["{{goalBaseUrl}}"],
              "path": ["goals", "{{goal_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Transactions (Транзакции)",
      "item": [
        {
          "name": "1. Sync Transactions (Import) (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 or 202\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
                  "});",
                  "",
                  "// BUSY WAIT: Даем 3 секунды асинхронному сервису на сохранение данных в БД",
                  "// Это костыль для Postman Runner/Newman, так как они выполняют запросы сразу",
                  "var end = Date.now() + 3000;",
                  "while (Date.now() < end);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "none"
            },
            "url": {
              "raw": "{{transactionBaseUrl}}/transactions/sync?year=2025&month=12",
              "host": ["{{transactionBaseUrl}}"],
              "path": ["transactions", "sync"],
              "query": [
                { "key": "year", "value": "2025" },
                { "key": "month", "value": "12" }
              ]
            }
          }
        },
        {
          "name": "2. Get List and Find Real ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "// Find ANY ID from the list to use for Get/Update tests",
                  "if(json.content && json.content.length > 0) {",
                  "    pm.environment.set(\"real_tx_id\", json.content[0].id);",
                  "} else {",
                  "    // Fail if empty, otherwise ID 1 will likely cause 404 in next tests",
                  "    // But keeping fallback for now to see failure downstream",
                  "    console.log(\"WARNING: No transactions found after sync!\");",
                  "    pm.environment.set(\"real_tx_id\", 1);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{transactionBaseUrl}}/transactions?page=0&size=5",
              "host": ["{{transactionBaseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "3. Get Transaction by ID (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.expect(json.id).to.eql(pm.environment.get(\"real_tx_id\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{transactionBaseUrl}}/transactions/{{real_tx_id}}",
              "host": ["{{transactionBaseUrl}}"],
              "path": ["transactions", "{{real_tx_id}}"]
            }
          }
        },
        {
          "name": "4. Change Transaction Category (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "// 999 is system category ID (often 'Uncategorized')",
                  "pm.expect(json.category.id).to.eql(999);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"categoryId\": 999\n}"
            },
            "url": {
              "raw": "{{transactionBaseUrl}}/transactions/{{real_tx_id}}/category",
              "host": ["{{transactionBaseUrl}}"],
              "path": ["transactions", "{{real_tx_id}}", "category"]
            }
          }
        },
        {
          "name": "5. Get Total Spent for Category (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.categoryId).to.eql(1);",
                  "pm.expect(jsonData).to.have.property('totalSpent');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{transactionBaseUrl}}/transactions/categories/1/total",
              "host": ["{{transactionBaseUrl}}"],
              "path": ["transactions", "categories", "1", "total"]
            }
          }
        }
      ]
    },
