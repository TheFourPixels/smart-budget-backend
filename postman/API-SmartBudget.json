        },
        {
          "name": "Delete Category (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "1" }
            ],
            "url": {
              "raw": "{{budgetBaseUrl}}/categories/{{created_cat_id}}",
              "host": ["{{budgetBaseUrl}}"],
              "path": ["categories", "{{created_cat_id}}"]
            }
          }
        }
      ]
    }
