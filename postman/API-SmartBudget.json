    {
      "name": "budgets",
      "item": [
        {
          "name": "Создать или обновить бюджет на период",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Budget created or updated successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().year).to.equal(2025);",
                  "    pm.expect(pm.response.json().month).to.equal(10);",
                  "    pm.expect(pm.response.json().totalIncome).to.equal(100000.00);",
                  "    pm.expect(pm.response.json().limits.length).to.equal(2);",
                  "    pm.expect(pm.response.json().limits[0].categoryId).to.equal(1);",
                  "    pm.expect(pm.response.json().limits[0].limitValue).to.equal(50.00);",
                  "    pm.expect(pm.response.json().limits[0].limitType).to.equal(\"PERCENT\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalIncome\": 100000.00,\n  \"limits\": [\n    {\n      \"categoryId\": 1,\n      \"limitValue\": 50.00,\n      \"limitType\": \"PERCENT\"\n    },\n    {\n      \"categoryId\": 2,\n      \"limitValue\": 50.00,\n      \"limitType\": \"PERCENT\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/budgets/2025/10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "budgets",
                "2025",
                "10"
              ]
            }
          },
          "response": []
        },
