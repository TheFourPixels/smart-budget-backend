{
  "info": {
    "_postman_id": "smart-budget-final-v4",
    "name": "Smart Budget API - Final & Robust Tests",
    "description": "Полный набор тестов для всех микросервисов (с исправлением Async и Cleanup)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "42953160"
